Options -Indexes
RewriteEngine On

# Ensure RewriteBase matches the subfolder
RewriteBase /f2/

# Remove .html extension for clean URLs within f2
RewriteCond %{THE_REQUEST} /f2/([^.]+)\.html [NC]
RewriteRule ^ /f2/%1 [R=301,L]

# Serve .html file for clean URL requests
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^([^.]+)$ $1.html [L]

# Force HTTPS
RewriteCond %{HTTPS} off
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]